FROM node:24-alpine AS build
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY build ./build
COPY src ./src
COPY public ./public
COPY index.html style.css ./
COPY sunwatch/vite.config.mjs ./sunwatch/vite.config.mjs
COPY sunwatch/public/model.js ./sunwatch/public/model.js
RUN node node_modules/vite/bin/vite.js build --config sunwatch/vite.config.mjs
RUN npm prune --omit=dev --ignore-scripts

FROM node:24-alpine
WORKDIR /app
COPY package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY server ./server
COPY scripts ./scripts
COPY src ./src
COPY config ./config
COPY LICENSE DATA_SOURCES.md ./
WORKDIR /app/sunwatch
COPY sunwatch/package.json sunwatch/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY sunwatch/server.mjs ./
COPY sunwatch/data ./data
COPY --from=build /app/sunwatch/dist ./dist
RUN mkdir -p .gev-cache && chown node:node .gev-cache
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4180
USER node
EXPOSE 4180
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:4180/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","server.mjs"]
